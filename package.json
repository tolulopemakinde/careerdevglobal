{
  "name": "careerdevglobal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:build-inputs && tar -xzf public/careerdev-global-assets.tgz -C public && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "audit:source": "node scripts/audit-source-config.mjs",
    "validate:linkedin-intake-evidence": "node scripts/validate-linkedin-intake-evidence.mjs",
    "check:build-inputs": "node scripts/verify-build-inputs.mjs",
    "validate:auth-manifest": "node scripts/validate-authorization-manifest.mjs",
    "validate:phase2-boundaries": "node scripts/validate-phase2-boundaries.mjs",
    "validate:edge-security": "node scripts/validate-edge-security-module.mjs",
    "validate:phase3-preview": "node scripts/validate-phase3-preview.mjs",
    "verify:phase1": "npm run audit:source && npm run typecheck && npm run check:build-inputs && npm run validate:auth-manifest",
    "verify:phase2": "npm run verify:phase1 && npm run validate:phase2-boundaries && npm run validate:edge-security",
    "verify:phase3": "npm run verify:phase2 && npm run validate:phase3-preview",
    "validate:phase4-simulation": "node scripts/validate-phase4-simulation.mjs",
    "verify:phase4": "npm run verify:phase3 && npm run validate:phase4-simulation",
    "test:intake-authorization": "node --test supabase/functions/careerdev-intake-engine-v2/authorization.test.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "10.75.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
